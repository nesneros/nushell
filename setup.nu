# setup.nu
#
# One-time setup for this Nushell config. config.nu runs this automatically
# on the first startup, when generated/init.nu doesn't exist yet.
#
# It appends startup scripts into generated/init.nu when the programs are
# installed. autoload/_load-generated.nu sources that file on later startups.
#
# It also caches brew's prefix in generated/homebrew-prefix.txt, which
# modules/homebrew.nu reads instead of spawning `brew --prefix` on every startup.
#
# It also writes generated/completions.nu: `generate completions` output for
# each command in completion_commands, sourced by autoload/_load-generated.nu.
#
# It also installs the local Git hooks: core.hooksPath points at this
# repository's own .git/hooks, and a post-merge hook re-runs setup.nu after a
# pull brings in new commits. Hooks inherited from the shared directory (normally
# ~/my-zcomet/githooks) are linked in, so global hooks keep working.
#
# Re-run it manually to refresh the generated script, after upgrading Homebrew,
# or after adding a Git hook:
#   nu ($nu.default-config-dir | path join setup.nu)
#
# mise is handled separately in config.nu, regenerated fresh every shell
# start instead of cached here.

const generated_file = ($nu.default-config-dir | path join "generated" "init.nu")

# Run `program ...args` and append stdout to generated/init.nu.
# Skips the program when it is not installed.
def generate [program: string, ...args: string] {
    if not (installed $program) {
        print $"($program) is not installed; skipped"
        return
    }

    $"\n# --- ($program) ---\n" | save --append $generated_file
    run-external $program ...$args | save --append $generated_file
    print $"Appended ($program)"
}

def installed [name: string] {
    not (which $name | where type == external | is-empty)
}

const homebrew_prefix_file = ($nu.default-config-dir | path join "generated" "homebrew-prefix.txt")

# Cache `brew --prefix`, which is stable for a given install and slow to
# shell out to on every startup.
def generate-homebrew-prefix [] {
    if not (installed brew) {
        print "brew is not installed; skipped"
        return
    }

    mkdir ($homebrew_prefix_file | path dirname)
    ^brew --prefix | str trim | save -f $homebrew_prefix_file
    print $"Wrote ($homebrew_prefix_file)"
}

const completions_file = ($nu.default-config-dir | path join "generated" "completions.nu")

# Commands whose completions aren't already covered well by carapace's own
# specs, generated instead via nu's own `generate completions` (from the
# command's carapace/fish/zsh completions, man page, or --help).
# Add a command name here to extend; skipped if it isn't installed.
const completion_commands = [mole]

# Write `generate completions` output for every installed command in
# completion_commands into one file (all extern definitions in one place,
# same pattern as generated/init.nu above).
#
# A `for` loop, not `each`: a bare call inside an `each` closure's `if`
# still implicitly inherits the closure's own piped input (the same
# first-statement-eats-$in quirk met elsewhere in this config), which
# `generate completions` then mistakes for --help/man text piped to it.
def generate-completions-file [] {
    mut sections = []
    for cmd in $completion_commands {
        if (installed $cmd) {
            $sections = ($sections | append (generate completions $cmd))
        } else {
            print $"($cmd) is not installed; skipped"
        }
    }

    if ($sections | is-empty) {
        return
    }

    mkdir ($completions_file | path dirname)
    $"# Generated by setup.nu via `generate completions`. Do not edit.\n\n($sections | str join "\n\n")\n"
    | save -f $completions_file
    print $"Wrote ($completions_file)"
}

# Register a nu plugin. Checks next to the `nu` binary first (eg. "gstat"),
# then falls back to `mise which` (eg. a cargo-backend mise tool).
def add-plugin [name: string] {
    let bundled_path = ($nu.current-exe | path dirname | path join $"nu_plugin_($name)")

    let plugin_path = if ($bundled_path | path exists) {
        $bundled_path
    } else if (installed mise) {
        let result = (^mise which $"nu_plugin_($name)" | complete)
        if $result.exit_code == 0 { $result.stdout | str trim } else { null }
    } else {
        null
    }

    if $plugin_path == null or ($plugin_path | is-empty) or not ($plugin_path | path exists) {
        print $"nu_plugin_($name) is not installed; skipped"
        return
    }

    if (plugin list | where name == $name | is-empty) {
        plugin add $plugin_path
        print $"Registered ($name)"
    } else {
        print $"($name) already registered"
    }
}

# --- Git hooks -------------------------------------------------------------

# Local post-merge hook, written by setup.nu because .git/hooks is not tracked.
# It is a Nushell script run through its shebang, so the hook is one line: a
# pull that brings in new commits re-runs setup.nu, regenerating
# generated/init.nu, completions.nu, the Homebrew prefix, and the plugins.
const post_merge_hook = '#!/usr/bin/env nu
# Managed by setup.nu: regenerate the generated files after a pull brings in new
# commits. Edit setup.nu rather than this file; it is rewritten when they differ.
exec nu (git rev-parse --show-toplevel | path join setup.nu)
'

# Run git in this directory and return its trimmed stdout, or null when the
# command fails (for example when this directory is not a Git checkout).
# Arguments are a list so Git flags don't look like Nushell flags.
def git-output [args: list<string>] {
    let result = (^git -C $nu.default-config-dir ...$args | complete)
    if $result.exit_code == 0 { $result.stdout | str trim } else { null }
}

# Resolve a possibly relative directory from Git config. Git resolves
# core.hooksPath relative to the top of the working tree.
def resolve-dir [repo: string, dir: string] {
    if ($dir | str starts-with "/") {
        $dir | path expand
    } else {
        $repo | path join $dir | path expand
    }
}

# Install this repository's local Git hooks, leaving the shared hooks in
# ~/my-zcomet/githooks untouched:
#
# * point core.hooksPath at the repository's own hooks directory (locally),
# * link in the hooks from the directory that was in effect before, so global
#   hooks such as commit-msg keep running,
# * write post-merge so a pull re-runs setup.nu.
#
# Idempotent: already correct files and symlinks are left alone.
def install-git-hooks [] {
    if not (installed git) {
        print "git is not installed; skipped"
        return
    }

    let repo = (git-output [rev-parse --show-toplevel])
    if $repo == null {
        print "Not a git repository; skipped"
        return
    }

    let common_dir = (git-output [rev-parse --git-common-dir])
    let hooks_dir = (resolve-dir $repo $common_dir | path join "hooks")

    # Captured before the override, so a re-run still knows which directory to
    # inherit from (normally the shared global one).
    let inherited = ([
            (git-output [config --get core.hooksPath])
            (git-output [config --global --get core.hooksPath])
        ]
        | compact
        | each {|dir| resolve-dir $repo $dir }
        | uniq
        | where {|dir| $dir != $hooks_dir })

    mkdir $hooks_dir

    let hook_file = ($hooks_dir | path join "post-merge")
    let current = (if ($hook_file | path exists) { open --raw $hook_file } else { "" })
    if $current != $post_merge_hook {
        $post_merge_hook | save -f $hook_file
        print $"Wrote ($hook_file)"
    }
    ^chmod +x $hook_file

    if (git-output [config --local --get core.hooksPath]) != $hooks_dir {
        ^git -C $repo config --local core.hooksPath $hooks_dir
        print $"Set core.hooksPath to ($hooks_dir)"
    }

    for dir in $inherited {
        if not ($dir | path exists) { continue }
        for hook in (ls $dir | where type in [file symlink]) {
            let name = ($hook.name | path basename)
            let target = ($hooks_dir | path join $name)
            if ($name | str ends-with ".sample") or ($target | path exists) { continue }
            ^ln -s $hook.name $target
            print $"Linked ($name) from ($dir)"
        }
    }
}

def main [] {
    mkdir ($generated_file | path dirname)
    "# Generated by setup.nu. Do not edit.\n" | save -f $generated_file

    generate atuin init nu -- --disable-up-arrow
    generate carapace _carapace nushell
    generate zoxide init nushell
    generate-homebrew-prefix
    generate-completions-file
    add-plugin formats
    add-plugin gstat
    add-plugin skim
    add-plugin port_extension
    install-git-hooks
}
