# setup.nu
#
# One-time setup for this Nushell config. config.nu runs this automatically
# on the first startup, when generated/init.nu doesn't exist yet.
#
# It appends startup scripts into generated/init.nu when the programs are
# installed. autoload/_load-generated.nu sources that file on later startups.
#
# It also caches zsh's default fpath in generated/zsh-fpath.txt, and brew's
# prefix in generated/homebrew-prefix.txt, which config.nu and modules/homebrew.nu
# read instead of spawning `zsh -f` or `brew --prefix` on every startup.
#
# It also writes generated/completions.nu: `generate completions` output for
# each command in completion_commands, sourced by autoload/_load-generated.nu.
#
# Re-run it manually to refresh the generated script, after upgrading
# zsh/Homebrew:
#   nu ($nu.default-config-dir | path join setup.nu)
#
# mise is handled separately in config.nu, regenerated fresh every shell
# start instead of cached here.

const generated_file = ($nu.default-config-dir | path join "generated" "init.nu")

# Run `program ...args` and append stdout to generated/init.nu.
# Skips the program when it is not installed.
def generate [program: string, ...args: string] {
    if not (installed $program) {
        print $"($program) is not installed; skipped"
        return
    }

    $"\n# --- ($program) ---\n" | save --append $generated_file
    run-external $program ...$args | save --append $generated_file
    print $"Appended ($program)"
}

def installed [name: string] {
    not (which $name | where type == external | is-empty)
}

const zsh_fpath_file = ($nu.default-config-dir | path join "generated" "zsh-fpath.txt")

# Cache the fpath zsh starts with when no rc files are read. It is stable for a
# given zsh/Homebrew install, so config.nu only probes as a fallback.
def generate-zsh-fpath [] {
    if not (installed zsh) {
        print "zsh is not installed; skipped"
        return
    }

    mkdir ($zsh_fpath_file | path dirname)
    ^env -u FPATH zsh -f -c 'print -rl -- $fpath' | save -f $zsh_fpath_file
    print $"Wrote ($zsh_fpath_file)"
}

const homebrew_prefix_file = ($nu.default-config-dir | path join "generated" "homebrew-prefix.txt")

# Cache `brew --prefix`, which is stable for a given install and slow to
# shell out to on every startup.
def generate-homebrew-prefix [] {
    if not (installed brew) {
        print "brew is not installed; skipped"
        return
    }

    mkdir ($homebrew_prefix_file | path dirname)
    ^brew --prefix | str trim | save -f $homebrew_prefix_file
    print $"Wrote ($homebrew_prefix_file)"
}

const completions_file = ($nu.default-config-dir | path join "generated" "completions.nu")

# Commands whose completions aren't already covered well by the
# carapace/zsh bridge, generated instead via nu's own `generate completions`
# (from the command's carapace/fish/zsh completions, man page, or --help).
# Add a command name here to extend; skipped if it isn't installed.
const completion_commands = [mole]

# Write `generate completions` output for every installed command in
# completion_commands into one file (all extern definitions in one place,
# same pattern as generated/init.nu above).
#
# A `for` loop, not `each`: a bare call inside an `each` closure's `if`
# still implicitly inherits the closure's own piped input (the same
# first-statement-eats-$in quirk met elsewhere in this config), which
# `generate completions` then mistakes for --help/man text piped to it.
def generate-completions-file [] {
    mut sections = []
    for cmd in $completion_commands {
        if (installed $cmd) {
            $sections = ($sections | append (generate completions $cmd))
        } else {
            print $"($cmd) is not installed; skipped"
        }
    }

    if ($sections | is-empty) {
        return
    }

    mkdir ($completions_file | path dirname)
    $"# Generated by setup.nu via `generate completions`. Do not edit.\n\n($sections | str join "\n\n")\n"
    | save -f $completions_file
    print $"Wrote ($completions_file)"
}

# Register a nu plugin. Checks next to the `nu` binary first (eg. "gstat"),
# then falls back to `mise which` (eg. a cargo-backend mise tool).
def add-plugin [name: string] {
    let bundled_path = ($nu.current-exe | path dirname | path join $"nu_plugin_($name)")

    let plugin_path = if ($bundled_path | path exists) {
        $bundled_path
    } else if (installed mise) {
        let result = (^mise which $"nu_plugin_($name)" | complete)
        if $result.exit_code == 0 { $result.stdout | str trim } else { null }
    } else {
        null
    }

    if $plugin_path == null or ($plugin_path | is-empty) or not ($plugin_path | path exists) {
        print $"nu_plugin_($name) is not installed; skipped"
        return
    }

    if (plugin list | where name == $name | is-empty) {
        plugin add $plugin_path
        print $"Registered ($name)"
    } else {
        print $"($name) already registered"
    }
}

def main [] {
    mkdir ($generated_file | path dirname)
    "# Generated by setup.nu. Do not edit.\n" | save -f $generated_file

    generate atuin init nu -- --disable-up-arrow
    generate carapace _carapace nushell
    generate zoxide init nushell
    generate-zsh-fpath
    generate-homebrew-prefix
    generate-completions-file
    add-plugin formats
    add-plugin gstat
    add-plugin skim
    add-plugin port_extension
}
